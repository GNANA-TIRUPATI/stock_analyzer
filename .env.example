# Indian Day-Trading Stock Analyzer - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATA PROVIDER CONFIGURATION
# =============================================================================

# Optional: API key for premium data providers (not needed for yfinance/openchart)
# MARKET_DATA_API_KEY=

# Primary data provider: "yfinance" or "openchart"
# DATA_PROVIDER=yfinance

# =============================================================================
# ANALYSIS CONFIGURATION
# =============================================================================

# Stock universe: NIFTY_50, NIFTY_100, NIFTY_200, NIFTY_500
# STOCK_UNIVERSE=NIFTY_200

# Default analysis period in trading days: 15 or 30
# DEFAULT_ANALYSIS_PERIOD=30

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Flask secret key (generate a random string for production)
# FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Flask host and port
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000

# Debug mode (set to false in production)
# FLASK_DEBUG=true

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum requests per second to data provider
# MAX_REQUESTS_PER_SECOND=2

# Request timeout in seconds
# REQUEST_TIMEOUT=30
